<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="style.css">

    <%- include ('partials/header') %>
</head>

<body>

    <div class="container">
        <strong><%= errMsg %></strong>
        <!-- Login Form -->
        <form action="/login" method="POST"> <!--Start of login form-->
            <!--The for attribute in the this tag is a link. It tells the label which input element it's associated with. -->
            <div class="form-group row">
                <label for="username" class="col-md-3 col-form-label">Username</label>
                <input name="username" type="text" id="username" class="form-control" aria-describedby="emailHelpInline"
                    placeholder="Enter your username">
            </div>
            <div class="form-group row">
                <label for="inputPassword" class="col-md-3 col-form-label">Password</label>
                <input name="password" type="password" id="inputPassword" class="form-control" aria-describedby="passwordHelpInline"
                    placeholder="Enter your password">
            </div>
            <!-- Sign-in Button -->
            <div class="form-group row">
                <!--takes up space = 3/12 to help positioning and alignment-->
                <div class="col-md-3"></div>
                <button type="submit" class="btn btn-primary btn-block mt-3">Sign In</button>
                <!--button has the primary Bootstrap button style,-->
            </div>
        </form>
    </div>
    <!-- Bootstrap JavaScript -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>
</html>