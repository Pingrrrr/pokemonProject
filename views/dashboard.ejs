<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokemon</title>
    <!-- Link Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!--< based footer off this css styling link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">-->
  <!--link custom css-->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
    crossorigin="anonymous"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <%- include ('partials/header') %>
    <h1>Welcome to your dashboard <%= session.username %></h1>
    <div>
        <i><%= session.username %>'s collections!
        <ul>
        <% collections.forEach((collection) => { %></i>
            <li>
            <a href="/cards?collection=<%= collection.collection_id %>"><%= collection.collection_name %></a>
        </li>
            <% }); %>
        </ul>
    </div>
    <div>
        <!--https://getbootstrap.com/docs/5.0/layout/columns/-->
        <div class="container mt-5">
            <div class="row justify-content-center">
              <div class="col-md-6">
                <form action="/dashboard" method="POST"> 
                    <!-- Start of login form -->
                  <div class="form-group">
                    <label for="collection">Collection name</label>
                    <input name="collection" type="text" id="collection" class="form-control" placeholder="Fire pokemon">
                  </div>
                  <!-- Sign-in Button -->
                  <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-block">Make a new collection</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        

    <%- include ('partials/footer') %>
</body>
