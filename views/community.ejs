<!DOCTYPE html>
<html lang="en">
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
    crossorigin="anonymous"></script>
<title>sets</title>

<head>
    <%- include ('partials/header') %>
</head>

<body>


    <div class="container mt-5">
        <h3><i>Check out these featured community collections!</i></h3>

        <% collections.forEach((collection)=> { %>
            <div class="card mb-4">
                <div class="card-header">
                    <a href="/cards?collection=<%= collection.collection_id %>">
                        <%= collection.collection_name %> (<%= collection.user_name %>)
                    </a>
                    <% collectionCards=cards.filter(card=> card.collection_id === collection.collection_id); %>
                        <% if (collectionCards.length> 0) { %>
                            <a href="/cards?collection=<%= collection.collection_id %>"
                                class="btn btn-primary btn-sm float-right"><small>Inspect collection</a></small>
                            <% } %>
                </div>
                <% if (collectionCards.length> 0) { %>
                    <!--https://getbootstrap.com/docs/5.0/components/card/-->
                    <div class="card-body">
                        <div class="row">
                            <% collectionCards.forEach((card)=> { %>
                                <div class="col-lg-2 col-md-3 col-sm-4 col-6 mb-4">
                                    <a href="/cards?collection=<%= card.collection_id %>">
                                        <img src="<%= card.image_url %>/low.webp" class="img-fluid mb-2"
                                            alt="<%= card.name %>"
                                            style="width: 100%; height: 200px; object-fit: contain">
                                        <p class="text-center">
                                            <%= card.name %>
                                        </p>
                                    </a>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="card-body">
                            <p class="text-center">No cards in this collection yet.</p>
                        </div>
                        <% } %>
            </div>
            <% }); %>
    </div>

    <%- include ('partials/footer') %>
</body>