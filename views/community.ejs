<!DOCTYPE html>
<html lang="en">
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<!--< based footer off this css styling link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">-->
<!--link custom css-->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
  crossorigin="anonymous"></script>
  <title>sets</title>
<head>
    <%- include ('partials/header') %>
</head>

<body>

    

    <div class="container mt-5">
        <h3><i>Check out the community collections!</h3></i>
        
        <% collections.forEach((value, key)=> { %>
            <h4>
            <a href="/cards?collection=<%= value.collection_id %>"><%= value.collection_name + " (" +value.user_name+")" %></a> 
        </h4>
        <div class="row">
          <% cards.forEach((card) => { %>
            <%  if(card.collection_id==value.collection_id){ %>
            <div class="col-lg-2 col-md-3 col-sm-4 col-6 text-center mb-4">
              <a href="/cards?collection=<%= card.collection_id %>">
                <img src="<%= card.image_url %>/low.webp" class="img-fluid mb-2" alt="<%= card.name %>" style="width: 100%; height: 200px; Object-fit: contain">
                <p><%= card.name %></p>
              </a>
            </div>
            <% } %>
          <% }); %>
        </div>
        <% }); %>
        
      </div>



      





    <%- include ('partials/footer') %>
</body>