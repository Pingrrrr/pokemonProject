<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokemon</title>
    <!-- Link Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!--< based footer off this css styling link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">-->
    <!--link custom css-->
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <%- include ('partials/header') %>
    <!--margain 5 for top and bottom-->
    <div id="jumbotron" class="container-fluid my-5">
        <!--body teriary for bootstrap colour theme, padding 5, rounded corners moderate-->
        <div class="p-5 align-items-center text-center rounded-3">
            <a href="images/pikachu.png">
                <img src="images/pikachu.png" alt="Pikachu" width="200">
            </a>
            <h1 class="text-body-emphasis">Welcome to Tradecard</h1>
            <!--column 8 / 12 in grid sys, margains auto, font size 5, text colour muted-->
            <p class="col-lg-8 mx-auto fs-5 text-muted">
                The best place for storing and viewing card collections
            </p>
            <!--flex container keeping inline, 2 gap, margain bottom-->
            <div class="d-inline-flex gap-10 mb-5 mx-5 px-10">
                <!--button aligned centre, flex container,  primary colour, large, 4padding-->
                <a href="/signup" class="btn-primary btn-outline-white btn-lg px-10 rounded-pill mx-1" role="button">
                    Sign up
                </a>
                <!--button 2nd color, large, 4 pixels, rounded pill shape-->
                <a href="/login" class="btn btn-outline-secondary btn-lg px-10 rounded-pill mx-1" role="button">
                    Log in
                </a>
                
            </div>
        </div>
    </div>

    <div>
        <h1 class="text-center my-4 font-weight-bold">
            <em>Gotta collect them all!</em>
        </h1>
    </div>


    <div class="row mb-4"> <!--marg bottom under imgs-->


        <!--sets the width of the column to be 2 columns wide on large-sized devices-->
        <% dataset.forEach((card) => { %>
            <div class="col-lg-2">
                <a href="/card?id=<%= card.card_id %>">
                    <div class="gallery-item">
                        <img src="<%= card.image_url %>/low.webp" class="img-fluid mb-4" alt="<%= card.name %>">
                    </div>
                </a>
            </div>
        <% }); %>
    </div>

    <!-- boostrap classes; footer is flex container, wrap on many lines if needed, even space on flex items, align items in centre margain 4 and padding 3-->
    <div class="container">
        <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
          <div class="col-md-4 d-flex align-items-center">
            <!--<img src="images/back.jpg" alt="" width="20" height="30" class="d-inline-block align-text-top">-->
            <span class="mb-3 mb-md-0 text-body-secondary">&copy; 2023 Tradecard, Inc</span>
            <!--bottom margain 3, no margain bottom for med + screen-->
          </div>
      <!--removes default listing, nav component, bootstrap styling-->
          <ul class="nav col-md-4 justify-content-end list-unstyled d-flex">
            <!--css marg space between images-->
            <li class="ms-3"><a class="text-body-secondary" href="#"><img src="images/reddit.png" class="bi" width="24" height="24"></img></a></li>
            <li class="ms-3"><a class="text-body-secondary" href="#"><img src="images/twitter-icon.webp" class="bi" width="24" height="24"></img></a></li>
            <li class="ms-3"><a class="text-body-secondary" href="#"><img src="images/discord.png" class="bi" width="24" height="24"></img></a></li>
          </ul>
        </footer>
      </div>

    <div id="banner" class="container-fluid">

        <!--        <a href="#">
            <img src="images/pokemon_banner.jpg" class="img-fluid" alt="Pokemon Banner">
        </a>-->
    </div>

    <!-- Link Bootstrap JavaScript -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
</body>

</html>