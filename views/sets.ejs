<!DOCTYPE html>
<html lang="en">
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>sets</title>
<head>
    <%- include ('partials/header') %>
</head>

<body>

    <div class="row mb-4">
        
        <% sets.forEach((set) => { %>

            <div class="col-lg-2">
                <a href="/cards?set=<%= set.set_id %>">
                    <div class="gallery-item">
                        <div class="mx-auto">
                        <img src="<%= set.image_url %>.webp" class="img-fluid mb-4" alt="<%= set.name %>">
                        <p class="text-center"><%=set.name%></p>
                        </div>
                    </div>
                </a>
            </div>
        <% }); %>
    </div>





    <%- include ('partials/footer') %>
</body>