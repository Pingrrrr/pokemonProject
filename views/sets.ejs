<!DOCTYPE html>
<html lang="en">
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
  crossorigin="anonymous"></script>
  <title>sets</title>
<head>
    <%- include ('partials/header') %>
</head>

<body>

    <div class="container mt-5">

        <% expansions.forEach((value, key)=> { %>
        <h3><%= value.expansion_name %></h3>
        <div class="row">
          <% sets.forEach((set) => { %>
            <%  if(set.expansion_id==value.expansion_id){ %>
            <div class="col-lg-2 col-md-3 col-sm-4 col-6 text-center mb-4">
              <a href="/cards?set=<%= set.set_id %>">
                <!--https://getbootstrap.com/docs/4.1/utilities/sizing/-->
                <!--https://getbootstrap.com/docs/5.3/utilities/object-fit/-->
                <img src="<%= set.image_url %>.webp" class="img-fluid mb-2" alt="<%= set.name %>" style="width: 100%; height: 100px; Object-fit: contain">
                <p><%= set.name %></p>
              </a>
            </div>
            <% } %>
          <% }); %>
        </div>
        <% }); %>
        Incubating brand new pokemon eggs! <strong>Check back soon...</strong>
      </div>

    <%- include ('partials/footer') %>
</body>