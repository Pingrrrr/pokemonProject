<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cards</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!--< based footer off this css styling link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">-->
    <!--link custom css-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"crossorigin="anonymous"></script>

  </head>
  <body>
    <%- include ('partials/header') %>
    
    <header>
      
    </header>

  <% if(messages.collectionMessage) { %>
      <div class="alert alert-success">
          <%= messages.collectionMessage %>
      </div>
      <% } %>

    

    <!-- dynamically set selected: https://stackoverflow.com/questions/65674796/how-do-i-update-which-option-is-selected-based-on-ejs-->
<form action="/cards" method="GET">

    <div class="form-inline" >

      <!-- dropdowns with checkboxes: https://stackoverflow.com/questions/25016848/bootstrap-putting-checkbox-in-a-dropdown-->
      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">Type</button>
        <ul class="dropdown-menu checkbox-menu allow-focus">
          <% types.forEach((type) => { %>
            <li><input type="checkbox" name="type" value="<%= type.name %>" <%=[].concat(lastQuery.type).includes(type.name) ? 'checked' : '' %>> <%= type.name %></li>
          <% }); %>
        </ul>
      </div>

      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">Stage</button>
        <ul class="dropdown-menu checkbox-menu allow-focus">
          <% stages.forEach((stage) => { %>
            <li><input type="checkbox" name="stage" value="<%= stage.stage %>" <%=[].concat(lastQuery.stage).includes(stage.stage) ? 'checked' : '' %>> <%= stage.stage %></li>
          <% }); %>
        </ul>
      </div>

      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">Rarity</button>
        <ul class="dropdown-menu checkbox-menu allow-focus">
          <% rarities.forEach((rarity) => { %>
            <li><input type="checkbox" name="rarity" value="<%= rarity.rarity %> <%=[].concat(lastQuery.rarity).includes(rarity.rarity) ? 'checked' : '' %>"> <%= rarity.rarity %></li>
          <% }); %>
        </ul>
      </div>

      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">Category</button>
        <ul class="dropdown-menu checkbox-menu allow-focus">
          <% categories.forEach((category) => { %>
            <li><input type="checkbox" name="category" value="<%= category.category %>" <%=[].concat(lastQuery.category).includes(category.category) ? 'checked' : '' %>> <%= category.category %></li>
          <% }); %>
        </ul>
      </div>

      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">Weakness</button>
        <ul class="dropdown-menu checkbox-menu allow-focus">
          <% types.forEach((type) => { %>
            <li><input type="checkbox" name="weakness" value="<%= type.name %>" <%=[].concat(lastQuery.weakness).includes(type.name) ? 'checked' : '' %>> <%= type.name %></li>
          <% }); %>
        </ul>
      </div>

      <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">Resistance</button>
        <ul class="dropdown-menu checkbox-menu allow-focus">
          <% types.forEach((type) => { %>
            <li><input type="checkbox" name="resistance" value="<%= type.name %>" <%=[].concat(lastQuery.resistance).includes(type.name) ? 'checked' : '' %>> <%= type.name %></li>
          <% }); %>
        </ul>
      </div>

      <button type="submit" class="btn btn-primary my-1 mx-1">Submit</button>
      <a href="/cards" class="btn btn-secondary my-1 mx-1">Clear</a>
      

      


        </div>

        <% Object.entries(lastQuery).forEach(([key, value]) => { %>

          <% [].concat(value).forEach((v) => { %>
          <button type="button" class="btn btn-outline-primary my-1 mx-1" disabled><%= key + ": " +v%></button>
          <% }); %>
    
        <% }); %>

        <div>
          <label for="sortby">Sort By: </label>
          <select name="sortby">
            <option value="pokedex" <%=lastQuery.sortby==='pokedex' ? 'selected' : '' %>>Pokedex Number</option>
            <option value="nameasc" <%=lastQuery.sortby==='nameasc' ? 'selected' : '' %>>Name (A-Z)</option>
            <option value="namedesc" <%=lastQuery.sortby==='namedesc' ? 'selected' : '' %>>Name (Z-A)</option>
          </select>
        </div>


      </form>




    <div class="row mb-4"> <!--marg bottom under imgs-->


      <!--sets the width of the column to be 2 columns wide on large-sized devices-->
      <% cards.forEach((card) => { %>

  <div class="card col-lg-2 mb-4 align-items-center">
    <a href="/card?id=<%= card.card_id %>">
        <img src="<%= card.image_url %>/low.webp" class="img-fluid mx-1 my-1" alt="<%= card.name %>">
  </a>

  <!-- only if user is logged in -->
  <% if(session.authen){ %>
    
  <div class="dropdown" action="/cards" method="GET">
    <button class="btn btn-primary dropdown-toggle" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
      Add to collection
    </button>
    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
      <% [].concat(collections).forEach((collection) => { %>
      <li>
        <form action="/cards" method="POST">
        <input type="hidden" name="card_id" value="<%= card.card_id %>">
        <input type="hidden" name="collection_id" value="<%= collection.collection_id %>">
        <button class="dropdown-item" type="submit" <%=collection.cards.includes(card.card_id) ? 'disabled' : '' %>><%= collection.collection_name %></button>
      </form>
      </li>
      <% }); %>
    </ul>
  </div>
  
  <% } %>

  </div>
      <% }); %>
  </div>

  

  <%- include ('partials/footer') %>
 </body>
</html>

