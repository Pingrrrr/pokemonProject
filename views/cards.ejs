<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cards</title>
  </head>
  <body>
    <%- include ('partials/header') %>
    
    <header>
      
    </header>

    <form class="form-inline" action="/cards" method="GET">
      <label class="my-1 mr-2" for="typeFilter">Type</label>
      <select class="custom-select my-1 mr-sm-2" id="typeFilter" name="type_f">
        <option disabled="" readonly="" selected>Type</option>
        <% types.forEach((type_v) => { %>
          <option><%= type_v.name %></option>
        <% }); %>
      </select>

      <label class="my-1 mr-2" for="stageFilter">Stage</label>
      <select class="custom-select my-1 mr-sm-2" id="stageFilter" name="stage_f">
        <option disabled="" readonly="" selected>Stage</option>
        <% stages.forEach((stage) => { %>
          <option><%= stage.stage %></option>
        <% }); %>
      </select>
    
      <button type="submit" class="btn btn-primary my-1">Submit</button>
    </form>

    <div class="row mb-4"> <!--marg bottom under imgs-->
      <!--sets the width of the column to be 2 columns wide on large-sized devices-->
      <% cards.forEach((card) => { %>
          <div class="col-lg-2">
              <a href="/card?id=<%= card.card_id %>">
                  <div class="gallery-item">
                      <img src="<%= card.image_url %>/low.webp" class="img-fluid mb-4" alt="<%= card.name %>">
                  </div>
              </a>
          </div>
      <% }); %>
  </div>

 </body>
</html>

