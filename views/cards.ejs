<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cards</title>
  </head>
  <body>
    <%- include ('partials/header') %>
    
    <header>
      
    </header>
    <div class="row mb-4"> <!--marg bottom under imgs-->


      <!--sets the width of the column to be 2 columns wide on large-sized devices-->
      <% dataset.forEach((card) => { %>
          <div class="col-lg-2">
              <a href="/card?id=<%= card.card_id %>">
                  <div class="gallery-item">
                      <img src="<%= card.image_url %>/low.webp" class="img-fluid mb-4" alt="<%= card.name %>">
                  </div>
              </a>
          </div>
      <% }); %>
  </div>

 </body>
</html>

