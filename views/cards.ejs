<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cards</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!--< based footer off this css styling link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">-->
    <!--link custom css-->
    <script language="javascript" src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

  </head>
  <body>
    <%- include ('partials/header') %>
    
    <header>
      
    </header>
    <!-- dynamically set selected: https://stackoverflow.com/questions/65674796/how-do-i-update-which-option-is-selected-based-on-ejs-->
    <form class="form-inline" action="/cards" method="GET">

      
      <select class="custom-select my-1 mr-sm-2" id="typeFilter" name="type">
        <option disabled="" readonly="" selected>Type</option>
        <% types.forEach((type) => { %>
          <option <%= [].concat(lastQuery.type).includes(type.name) ? 'selected' :'' %>> <%= type.name %></option>
        <% }); %>
      </select>

      <select class="custom-select my-1 mr-sm-2" id="stageFilter" name="stage">
        <option disabled="" readonly="" selected>Stage</option>
        <% stages.forEach((stage) => { %>
          <option><%= stage.stage %></option>
        <% }); %>

      </select>

      <select class="custom-select my-1 mr-sm-2" id="rarityFilter" name="rarity">
        <option disabled="" readonly="" selected>Rarity</option>
        <% rarities.forEach((rarity) => { %>
          <option><%= rarity.rarity %></option>
        <% }); %>
      </select>

      <select class="custom-select my-1 mr-sm-2" id="categoryFilter" name="category">
        <option disabled="" readonly="" selected>Category</option>
        <% categories.forEach((category) => { %>
          <option><%= category.category %></option>
        <% }); %>
      </select>


      <select class="custom-select my-1 mr-sm-2" id="weaknessFilter" name="weakness">
        <option disabled="" readonly="" selected>Weakness</option>
        <% types.forEach((weakness) => { %>
          <option><%= weakness.name %></option>
        <% }); %>
      </select>

      <select class="custom-select my-1 mr-sm-2" id="resistanceFilter" name="resistance">
        <option disabled="" readonly="" selected>Resistance</option>
        <% types.forEach((resistance) => { %>
          <option><%= resistance.name %></option>
        <% }); %>
      </select>
    
      <button type="submit" class="btn btn-primary my-1">Submit</button>
    </form>

    <div class="row mb-4"> <!--marg bottom under imgs-->
      <!--sets the width of the column to be 2 columns wide on large-sized devices-->
      <% cards.forEach((card) => { %>
          <div class="col-lg-2">
              <a href="/card?id=<%= card.card_id %>">
                  <div class="gallery-item">
                      <img src="<%= card.image_url %>/low.webp" class="img-fluid mb-4" alt="<%= card.name %>">
                  </div>
              </a>
          </div>
      <% }); %>
  </div>

 </body>
</html>

