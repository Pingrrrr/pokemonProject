<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!--< based footer off this css styling link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">-->
  <!--link custom css-->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
    crossorigin="anonymous"></script>
    <!-- my CSS -->
    <link rel="stylesheet" href="style.css">
    <%- include ('partials/header') %>
</head>
<body>
    <div class="container"> <!-- marg bottom 4-->
        <h2 class="text-center mb-4">Sign Up</h2>
        <form action="/signup" method="POST">
            <div class="form-group">
                <label for="username">User Name</label> <!--bootstrap form-control for styling forms uniformly-->
                <input name="username" type="text" class="form-control" id="username" placeholder="Enter your username">
            </div>

            <!--form group for bootstrap styling and layout-->
            <div class="form-group">
                <label for="password">Password</label>
                <input name="password" type="password" class="form-control" id="password" placeholder="Enter your password">
            </div>
            <!--checkbox for t&C-->
            <div class="form-group form-check">
                <input type="checkbox" class="form-check-input" id="termsCheck">
                <label class="form-check-label" for="termsCheck">I agree to the terms and conditions</label>
            </div> <!--primary action button to strech across container-->
            <button type="submit" class="btn btn-primary btn-block">Sign Up</button>
        </form>
    </div>
    <!-- Bootstrap JS -->

    <%- include ('partials/footer') %>
</body>
</html>
