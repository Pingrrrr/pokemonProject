<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>cards</title>

  <style>
    .gallery-item-wrapper {
      display: flex;
      align-items: center;
    }
    .image-wrapper {
      flex: 0 0 auto; 
    }

    .name-description {
      flex: 1;
    }

    .image-wrapper img {
      width: 100%; 
      height: auto; 
    }
  </style>
</head>
<body>
  <%- include ('partials/header') %>
  <header>
  </header>

  <div class="gallery-item-wrapper">
    
    <div class="image-wrapper">
      
      <img src="<%= card.image_url %>/high.webp" class="img-fluid" alt="<%= card.name %>">

    </div>
    <div class="name-description">
      <!--https://getbootstrap.com/docs/4.2/layout/grid/-->
      <div class="container">
        <h3><i><%= card.name %></i></h3>
        <h4>General information</h4>
        <div class="row">
          <div class="col-sm">
            HP: <%= card.hp %>
          </div>
          <div class="col-sm">
            Pokedex ID: <%= card.pokedex_id %>
          </div>
          <div class="col-sm">
            Stage: <%= card.stage %>
          </div>
        </div>
        <div class="row">
          <div class="col-sm">
            Set: <%= card.set_id %>
          </div>
          <div class="col-sm">
            Rarity: <%= card.rarity %>
          </div>
          <div class="col-sm">
            Illustrator: <%= card.illustrator %>
          </div>
        </div>
        <div class="row">
          <div class="col-sm">
            Evolved from: <%= card.evolved_from%>
          </div>
        </div>
      </div>
      <h3>Types</h3>
      <% card.types.forEach((type) => { %>
        <h5><i><%= type.name %></i></h5>
      <% }); %>

      <h3><i>Attacks</i></h3>
      <% card.attacks.forEach((attack) => { %>
        <h5><i><%= attack.name %></i></h5>
        <p><%= attack.description %></p>
      <% }); %>

      <h3><i>Abilities</i></h3>
      <% card.abilities.forEach((ability) => { %>
        <h5><i><%= ability.name %></i></h4>
        <p><%= ability.description %></p>
      <% }); %>
      <h3><i>Resistances</i></h3>
      <% card.resistances.forEach((resistance) => { %>
        <h5><i><%= resistance.name %></i></h4>
        <p><%= resistance.severity %></p>
      <% }); %>
      <h3><i>Weaknesses</i></h3>
      <% card.weaknesses.forEach((weakness) => { %>
        <h5><i><%= weakness.name %></i></h4>
        <p><%= weakness.severity %></p>
      <% }); %>



      
    </div>
  </div>
  <%- include ('partials/footer') %>
</body>
</html>
